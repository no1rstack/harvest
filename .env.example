# Harvest — Collection Platform
# Infisical project: f7f058b6-d267-45c1-9311-e0962a74e923 (crypt.noirstack.com / prod)
# Bootstrap: ./scripts/infisical/bootstrap-harvest-secrets.sh

# ── Database ──
HARVEST_DATABASE_URL=postgresql://harvest_user:CHANGE_ME@postgres-main:5432/harvest
HARVEST_PG_HOST_REWRITE=0
H3XA_PG_HOST_REWRITE=0

# ── Runtime ──
PORT=3020
HOST=0.0.0.0
HARVEST_PUBLIC_URL=https://harvest.noirstack.com
JUDICIUM_PUBLIC_URL=https://judicium.app
# JUDICIUM_INTERNAL_URL=http://judicium:3002
# JUDICIUM_URL=https://judicium.app
# JUDICIUM_SERVICE_TOKEN=  # required for finalize → Judicium /api/v1 evidence

# ── Keycloak (harvest.noirstack.com) ──
KEYCLOAK_BASE_URL=https://auth.noirstack.com
KEYCLOAK_REALM=gateway
KEYCLOAK_CLIENT_ID=harvest-noirstack
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://harvest.noirstack.com/api/harvest/auth/callback
KEYCLOAK_HOME_URL=https://harvest.noirstack.com
HARVEST_AUTH_REQUIRED=1
HARVEST_COOKIE_SECURE=1

# ── Cascades integration ──
COLLECTION_INTERNAL_TOKEN=
COLLECTION_API_URL=http://harvest:3000
CASCADES_API_URL=http://cascades:3000
CASCADES_PUBLIC_URL=https://cascades.work

# ── Platform scheduler ──
HARVEST_SCHEDULER_ENABLED=1
HARVEST_CASCADES_DUE_ENABLED=1
HARVEST_CASCADES_DUE_INTERVAL_MINUTES=60
HARVEST_CASCADES_DUE_LIMIT=100
HARVEST_DAILY_PULL_ENABLED=1
# Shared corpora (AIID / APTnotes) — same path as RSS → community_items
# HARVEST_FEEDS_CORPUS_INTERVAL_HOURS=24
# Requires JUDICIUM_INTERNAL_URL so Harvest can pull GET /api/search/aiid/corpus
HARVEST_DAILY_PULL_MODE=cascades-due
HARVEST_DAILY_PULL_INTERVAL_HOURS=24
HARVEST_DAILY_PULL_DRY_RUN=0

# ── Community feeds ──
HARVEST_FEEDS_ENABLED=1
HARVEST_FEEDS_DELEGATE_JUDICIUM=1
HARVEST_FEEDS_LAYERS_INTERVAL_MINUTES=30
HARVEST_FEEDS_RSS_INTERVAL_MINUTES=15
HARVEST_FEEDS_DAILY_INTERVAL_HOURS=24
HARVEST_FEEDS_STARTUP_DELAY_SECONDS=20
HARVEST_PLATFORM_CONFIG_DIR=/app/data

# ── Local LLM enrich (OpenAI-compatible / Ollama; same contract as Judicium) ──
# HARVEST_LLM_ENRICH=0 to disable. Default: on (rule-based fallback if model down).
HARVEST_LLM_ENRICH=1
HARVEST_LLM_MODEL=qwen2.5-coder:7b-instruct
HARVEST_LLM_ENRICH_LIMIT=20
HARVEST_LLM_TIMEOUT_MS=12000
OLLAMA_URL=http://host.containers.internal:11434/v1/chat/completions
# LITELLM_BASE_URL=
# COPILOT_API_URL=

# ── Cross-product wiring (documentary — Judicium reads Harvest HTTP) ──
HARVEST_INTELLIGENCE_URL=https://harvest.noirstack.com
JUDICIUM_USE_HARVEST_INTELLIGENCE=1

# ── CI deploy (optional) ──
GHCR_USERNAME=no1rstack
GHCR_PASSWORD=

# ── @noirstack/web-foundation — hashed IP telemetry ──
WEB_FOUNDATION_IP_TRACKING=true
WEB_FOUNDATION_REQUEST_LOGGING=true
WEB_FOUNDATION_IP_HASH_SALT=

# Forward hashed request events to hex-arch-service (hex-arch.com)
HEX_ARCH_EVENTS_URL=https://app.hex-arch.com/api/internal/events
HEX_ARCH_EVENTS_TOKEN=
