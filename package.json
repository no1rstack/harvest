{
  "name": "harvest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Noir Stack Collection Platform — OSINT registry, observations, Intelligence Core v1",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "osint:harvest": "tsx scripts/osint-harvest/index.ts",
    "osint:harvest:list": "tsx scripts/osint-harvest/index.ts --list",
    "osint:db:sync": "bash scripts/sync-infisical-db.sh",
    "infisical:sync": "bash scripts/sync-infisical-env.sh",
    "feeds:import:legal": "tsx scripts/import-legal-feeds.ts",
    "osint:daily": "bash scripts/osint-harvest/daily-pull.sh",
    "osint:daily:dry": "bash scripts/osint-harvest/daily-pull.sh --dry-run",
    "osint:collect": "tsx scripts/osint-harvest/collect.ts",
    "osint:collect:due": "tsx scripts/osint-harvest/collect.ts --due",
    "osint:registry:seed": "tsx scripts/osint-harvest/collect.ts --seed",
    "osint:platform:bootstrap": "tsx scripts/osint-harvest/platform-bootstrap.ts",
    "osint:migrate:shared": "tsx scripts/osint-harvest/migrate-to-shared.ts",
    "osint:serve": "bash scripts/osint-harvest/serve.sh"
  },
  "dependencies": {
    "@noirstack/web-foundation": "^0.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.9.3",
    "helmet": "^8.2.0",
    "lucide-react": "^0.546.0",
    "opossum": "^10.0.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "p-retry": "^8.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vitest": "^4.1.9"
  }
}
